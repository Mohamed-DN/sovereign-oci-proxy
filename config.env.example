# ==========================================================
# Sovereign OCI Proxy - Master Configuration
# Rename this file to config.env and edit before installing!
# ==========================================================

# 1. DuckDNS Configuration
# Used to keep your Oracle IP synced to a domain
DUCKDNS_DOMAIN="YOUR-SUBDOMAIN"
DUCKDNS_TOKEN="YOUR-DUCKDNS-TOKEN"

# 2. Notifications (Ntfy)
# Used to send you alerts if honeypots are triggered or DuckDNS fails
NTFY_URL="https://ntfy.sh/YOUR-SECRET-TOPIC-HERE"

# 3. Backups (GPG)
# The email address for your public GPG key to encrypt backups
GPG_RECIPIENT="YOUR_EMAIL_HERE"
