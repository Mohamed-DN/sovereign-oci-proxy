# ==========================================================
# Sovereign OCI Proxy - Master Configuration
# Rename this file to config.env and edit before installing!
# ==========================================================

# 1. DuckDNS Configuration
# Used to keep your Oracle IP synced to a domain
DUCKDNS_DOMAIN="YOUR-SUBDOMAIN"
DUCKDNS_TOKEN="YOUR-DUCKDNS-TOKEN"

# 2. Notifications & Command (Ntfy + Telegram)
# Ntfy is for passive alerts (Honeypot, DuckDNS failure)
NTFY_URL="https://ntfy.sh/YOUR-SECRET-TOPIC-HERE"

# Telegram is for the interactive Management Bot (C2)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_ID=""

# 3. Backups (GPG)
# The email address for your public GPG key to encrypt backups
GPG_RECIPIENT="YOUR_EMAIL_HERE"

# 4. WireGuard VPN (Gaming & Full VPN Mode)
# Native Layer 3 tunnel for apps that can't use the VLESS proxy
# (Among Us, WhatsApp calls, any UDP-based app)
WG_PORT="443"
WG_NETWORK="10.66.66"
# Primary DNS is the local Ad-blocker (dnsmasq), fallback is Cloudflare
WG_DNS="10.66.66.1, 1.1.1.1"
